{
  "name": "simulator-mandata-srbija",
  "private": true,
  "version": "1.1.0",
  "description": "Interaktivni matematički simulator raspodele 250 poslaničkih mandata (D'Hondt, cenzus 3%) — Republika Srbija",
  "author": "Mihailo Jović",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/MihailoJovic/simulator-mandata.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "release": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "postcss": "8.4.49",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "rs.simulator.mandata",
    "productName": "Simulator mandata",
    "copyright": "Matematički i edukativni alat — nije prognoza izbora",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Simulator mandata",
      "artifactName": "Simulator-mandata-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MihailoJovic",
        "repo": "simulator-mandata",
        "releaseType": "release"
      }
    ]
  }
}
